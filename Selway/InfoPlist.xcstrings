    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway bittet den Finder, Objekte anzuzeigen und „Informationen“ zu öffnen, und das Terminal, Ordner für Claude Code und Codex zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selway asks Finder to show items and open Get Info, and Terminal to open folders for Claude Code and Codex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway pide al Finder que muestre ítems y abra Obtener información, y a Terminal que abra carpetas para Claude Code y Codex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway demande au Finder d’afficher des éléments et d’ouvrir la fenêtre Lire les informations, et à Terminal d’ouvrir des dossiers pour Claude Code et Codex."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway chiede al Finder di mostrare gli elementi e aprire Ottieni informazioni, e a Terminale di aprire le cartelle per Claude Code e Codex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selwayは、項目を表示して“情報を見る”を開くようFinderに、Claude CodeやCodexのためにフォルダを開くよう“ターミナル”に依頼します。"
          }
        }
      }
