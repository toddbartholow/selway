    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway sucht in deinem Netzwerk nach Dateiservern, um sie in der Seitenleiste unter „Netzwerk“ aufzulisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selway looks for file servers on your network to list under Network in the sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway busca servidores de archivos en tu red para mostrarlos en Red, en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway recherche les serveurs de fichiers de votre réseau pour les afficher sous Réseau dans la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selway cerca i file server nella tua rete per elencarli sotto Rete nella barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selwayは、サイドバーの“ネットワーク”に表示するために、ネットワーク上のファイルサーバを探します。"
          }
        }
      }
    }
