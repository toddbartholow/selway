          }
        }
      }
    },
    "The password in the address isn’t used or kept. macOS asks for it, and can keep it in your keychain." : {
      "comment" : "Hint explaining that passwords in server addresses are ignored",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort in der Adresse wird weder verwendet noch gespeichert. macOS fragt danach und kann es in deinem Schlüsselbund sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de la dirección no se usa ni se guarda. macOS te la pide y puede guardarla en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe figurant dans l’adresse n’est ni utilisé ni conservé. macOS vous le demande et peut le conserver dans votre trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password nell’indirizzo non viene usata né conservata. macOS la richiede e può conservarla nel tuo portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
