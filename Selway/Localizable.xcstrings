    },
    "“%@” can’t be redone any more, so it was removed from the redo history." : {
      "comment" : "Redo history error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht mehr wiederholt werden und wurde daher aus dem Wiederholen-Verlauf entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no se puede rehacer, así que se ha eliminado del historial de rehacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rétablir « %@ » ; l’action a donc été retirée de l’historique de rétablissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può più essere ripristinato, quindi è stato rimosso dalla cronologia di ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はこれ以上やり直せないため、やり直し履歴から削除されました。"
          }
        }
      }
    },
    "“%@” can’t be undone any more, so it was removed from the undo history." : {
      "comment" : "Undo history error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
