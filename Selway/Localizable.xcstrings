    "The server didn’t accept the connection. Check that it’s turned on and shares files over %@." : {
      "comment" : "Server connection failure with protocol name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Verbindung nicht angenommen. Prüfe, ob er eingeschaltet ist und Dateien über %@ freigibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no ha aceptado la conexión. Comprueba que está encendido y que comparte archivos por %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas accepté la connexion. Vérifiez qu’il est allumé et qu’il partage des fichiers via %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha accettato la connessione. Verifica che sia acceso e che condivida file tramite %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが接続を受け付けませんでした。サーバの電源が入っていて、%@でファイルを共有していることを確認してください。"
          }
        }
      }
    },
    "The server doesn’t support a way of connecting this Mac can use." : {
      "comment" : "Server connection failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
