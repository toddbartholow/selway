    "Text size %lld%%" : {
      "comment" : "VoiceOver announcement after changing browser text size",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textgröße %lld %%"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño del texto: %lld %%"
          }
        },
        "fr" : {
          "stringUnit" : {
