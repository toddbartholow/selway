    "“%@” can’t be moved to the Trash. Delete it permanently?" : {
      "comment" : "Offer to delete one item, by name, on a volume without a Trash",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht in den Papierkorb gelegt werden. Endgültig löschen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se puede trasladar a la papelera. ¿Quieres eliminarlo permanentemente?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de placer « %@ » dans la corbeille. Le supprimer définitivement ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può essere spostato nel Cestino. Vuoi eliminarlo definitivamente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をゴミ箱に入れることができません。完全に削除しますか?"
          }
        }
      }
    },
    "“%@” can't be opened for editing." : {
      "comment" : "Text editor open error with file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht zum Bearbeiten geöffnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se puede abrir para editarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir « %@ » pour le modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire “%@” per la modifica."
