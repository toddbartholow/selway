          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no se puede deshacer, así que se ha eliminado del historial de deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’annuler « %@ » ; l’action a donc été retirée de l’historique d’annulation."
