    "“%@” is no longer the item Selway moved or copied (something else has taken its place), so it was left alone." : {
      "comment" : "Undo error with item name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht mehr das Objekt, das Selway bewegt oder kopiert hat (etwas anderes befindet sich jetzt an seiner Stelle), daher wurde es nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no es el ítem que Selway trasladó o copió (otra cosa ha ocupado su lugar), así que no se ha tocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est plus l’élément que Selway a déplacé ou copié (un autre élément a pris sa place) ; il n’a donc pas été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è più l’elemento che Selway ha spostato o copiato (qualcos’altro ne ha preso il posto), quindi non è stato toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はSelwayが移動またはコピーした項目ではなくなったため（別の項目に置き換えられています）、そのままにしました。"
          }
        }
      }
    },
    "“%@” is still running." : {
      "comment" : "Quit confirmation title while one file operation is running",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ läuft noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sigue en curso."
          }
        },
