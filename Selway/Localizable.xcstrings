    "Ask before a rename changes, adds or removes a file’s extension, which can change the app it opens in." : {
      "comment" : "Settings explanation for the confirmation shown when a rename changes a file extension.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachfragen, bevor beim Umbenennen das Suffix einer Datei geändert, hinzugefügt oder entfernt wird, da sich dadurch die App ändern kann, mit der sie geöffnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
