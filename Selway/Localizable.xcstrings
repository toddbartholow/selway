    "“%@” gave an address Selway won’t connect to. Type its address above instead." : {
      "comment" : "Network server resolution error with server name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat eine Adresse angegeben, mit der sich Selway nicht verbindet. Gib die Adresse stattdessen oben ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha dado una dirección a la que Selway no se conectará. Escribe su dirección arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a fourni une adresse à laquelle Selway refuse de se connecter. Saisissez plutôt son adresse ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha fornito un indirizzo a cui Selway non si connette. Digita invece il suo indirizzo qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”から、Selwayが接続しないアドレスが返されました。代わりに上の欄にアドレスを入力してください。"
          }
        }
      }
    },
    "“%@” has changed since it was copied (it is a different item now), so it was left alone." : {
      "comment" : "Undo error with item name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat sich seit dem Kopieren geändert (es ist jetzt ein anderes Objekt), daher wurde es nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha cambiado desde que se copió (ahora es un ítem distinto), así que no se ha tocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a changé depuis sa copie (il s’agit désormais d’un autre élément) ; il n’a donc pas été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è cambiato da quando è stato copiato (ora è un elemento diverso), quindi non è stato toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はコピーされた後に変更されたため（現在は別の項目です）、そのままにしました。"
          }
        }
      }
    },
    "“%@” is already in that folder" : {
      "comment" : "File operation status with item name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ befindet sich bereits in diesem Ordner"
          }
