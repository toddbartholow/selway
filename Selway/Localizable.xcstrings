    },
    "“%@” is connected already. Look for it under Locations." : {
      "comment" : "Connection error when a server is mounted but its volume location cannot be determined",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits verbunden. Suche es unter „Orte“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya está conectado. Búscalo en Ubicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà connecté. Recherchez-le sous Emplacements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è già connesso. Cercalo sotto Posizioni."
