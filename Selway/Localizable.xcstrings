    "Names can’t contain “/”. Please choose another name." : {
      "comment" : "File name validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen dürfen kein „/“ enthalten. Wähle einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres no pueden contener “/”. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms ne peuvent pas contenir « / ». Veuillez choisir un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi non possono contenere “/”. Scegli un altro nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前に“/”を含めることはできません。別の名前を選んでください。"
          }
        }
      }
    },
    "Names can’t contain control characters such as line breaks or tabs." : {
      "comment" : "File name validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen dürfen keine Steuerzeichen wie Zeilenumbrüche oder Tabulatoren enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres no pueden contener caracteres de control, como saltos de línea o tabulaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms ne peuvent pas contenir de caractères de contrôle, comme des sauts de ligne ou des tabulations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi non possono contenere caratteri di controllo come interruzioni di riga o tabulazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前に改行やタブなどの制御文字を含めることはできません。"
          }
        }
      }
    },
    "Names can’t contain invisible text-direction characters, which can disguise a file’s real extension." : {
      "comment" : "File name validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen dürfen keine unsichtbaren Zeichen für die Textrichtung enthalten, da diese das tatsächliche Suffix einer Datei verschleiern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres no pueden contener caracteres invisibles de dirección del texto, que pueden ocultar la extensión real de un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms ne peuvent pas contenir de caractères invisibles de direction du texte, qui peuvent masquer la véritable extension d’un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi non possono contenere caratteri invisibili di direzione del testo, che possono nascondere la vera estensione di un file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前に不可視の文字方向制御文字を含めることはできません。これらはファイルの本当の拡張子を偽装するおそれがあります。"
          }
        }
      }
    },
    "Names can’t start or end with a space. Please choose another name." : {
      "comment" : "File name validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen dürfen nicht mit einem Leerzeichen beginnen oder enden. Wähle einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres no pueden empezar ni terminar con un espacio. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms ne peuvent ni commencer ni se terminer par un espace. Veuillez choisir un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi non possono iniziare o finire con uno spazio. Scegli un altro nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前の先頭または末尾をスペースにすることはできません。別の名前を選んでください。"
          }
        }
      }
    },
