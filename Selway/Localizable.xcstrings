          }
        }
      }
    },
    "A server address can’t contain “?” or “#”. In a name, type them as %1$@ and %2$@." : {
      "comment" : "Server address validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Serveradresse darf weder „?“ noch „#“ enthalten. Gib sie in einem Namen als %1$@ und %2$@ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección de servidor no puede contener “?” ni “#”. En un nombre, escríbelos como %1$@ y %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse de serveur ne peut pas contenir « ? » ni « # ». Dans un nom, saisissez-les sous la forme %1$@ et %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indirizzo server non può contenere “?” o “#”. In un nome, digita %1$@ e %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバアドレスに“?”や“#”は使用できません。名前に含める場合は、%1$@と%2$@と入力してください。"
          }
        }
      }
    },
