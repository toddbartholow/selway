            "value" : "Le cartelle aperte dalla Scrivania, dal Finder, dal Dock o da altre app si aprono nel Finder. macOS non consente a un’altra app di sostituirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
