    "Overwrite replaces the version on disk with yours. Reload from Disk discards your unsaved changes." : {
      "comment" : "Save conflict alert explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Überschreiben“ ersetzt die Version auf dem Datenträger durch deine. „Vom Datenträger neu laden“ verwirft deine nicht gesicherten Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrescribir reemplaza la versión del disco por la tuya. Volver a cargar desde el disco descarta tus cambios no guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Écraser » remplace la version sur le disque par la vôtre. « Recharger depuis le disque » supprime vos modifications non enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovrascrivi sostituisce la versione sul disco con la tua. Ricarica dal disco annulla le modifiche non salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“上書き”を選択すると、ディスク上のバージョンが自分のバージョンで置き換えられます。“ディスクから再読み込み”を選択すると、保存していない変更は破棄されます。"
          }
        }
      }
    },
