    "Into %@. Any whose names are taken there get new ones." : {
      "comment" : "Confirmation detail for two or more items; destination folder path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %@. Objekte, deren Namen dort bereits vergeben sind, erhalten neue Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@. Los que tengan un nombre que ya esté en uso allí recibirán uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %@. Ceux dont le nom y est déjà pris reçoivent un nouveau nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@. Quelli il cui nome è già in uso lì ne ricevono uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宛先: %@。同じ名前の項目がすでにある場合は、新しい名前が付けられます。"
          }
        }
      }
    },
    "Into %@. If its name is taken there, the copy gets a new one." : {
      "comment" : "Confirmation detail for copying one item; destination folder path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %@. Ist der Name dort bereits vergeben, erhält die Kopie einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@. Si su nombre ya está en uso allí, la copia recibirá uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %@. Si son nom y est déjà pris, la copie reçoit un nouveau nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@. Se il nome è già in uso lì, la copia ne riceve uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宛先: %@。同じ名前の項目がすでにある場合は、コピーに新しい名前が付けられます。"
          }
        }
      }
    },
    "Into %@. If its name is taken there, the item gets a new one." : {
      "comment" : "Confirmation detail for moving one item; destination folder path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %@. Ist der Name dort bereits vergeben, erhält das Objekt einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@. Si su nombre ya está en uso allí, el ítem recibirá uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %@. Si son nom y est déjà pris, l’élément reçoit un nouveau nom."
          }
