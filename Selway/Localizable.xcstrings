          }
        }
      }
    },
    "What Command-Delete does to the selected items. ⌥⌘⌫ moves to the Trash." : {
      "comment" : "Settings explanation of what Command-Delete does when moving items to the Trash is selected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Befehl-Rückschritttaste mit den ausgewählten Objekten macht. ⌥⌘⌫ legt sie in den Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hace Comando + Eliminar con los ítems seleccionados. ⌥⌘⌫ los traslada a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effet de la combinaison Commande + Supprimer sur les éléments sélectionnés. ⌥⌘⌫ place les éléments dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fa Comando-Elimina agli elementi selezionati. ⌥⌘⌫ sposta nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
