    "%1$@\n\n%2$@ A shell opened in a folder you don't trust can run code from it (for example its git hooks or config, read by your shell prompt)." : {
      "comment" : "External link security warning with folder path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@ Eine Shell, die in einem Ordner geöffnet wird, dem du nicht vertraust, kann Code daraus ausführen (zum Beispiel seine Git-Hooks oder seine Konfiguration, die deine Shell-Eingabeaufforderung liest)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@ Un shell abierto en una carpeta de la que no te fías puede ejecutar código de ella (por ejemplo, sus hooks o su configuración de git, que lee el indicador de tu shell)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@ Un shell ouvert dans un dossier auquel vous ne faites pas confiance peut exécuter du code qui s’y trouve (par exemple ses hooks git ou sa configuration, lus par l’invite de votre shell)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@ Una shell aperta in una cartella di cui non ti fidi può eseguire codice proveniente da essa (ad esempio i suoi hook git o la sua configurazione, letti dal prompt della shell)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n%2$@信頼していないフォルダで開いたシェルは、そのフォルダ内のコードを実行できます（たとえば、シェルのプロンプトが読み込むgitフックや設定など）。"
          }
        }
      }
    },
