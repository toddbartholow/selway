    "Reconnect the missing disk or server and unlock the locked item or folder, then choose %@ again to finish." : {
      "comment" : "Suggested fixes for a missing volume and permission failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde das fehlende Volume oder den fehlenden Server erneut und entsperre das geschützte Objekt oder den geschützten Ordner. Wähle dann erneut „%@“, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectar el disco o servidor que falta y desbloquea el ítem o la carpeta bloqueados; luego vuelve a elegir %@ para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez le disque ou le serveur manquant et déverrouillez l’élément ou le dossier verrouillé, puis choisissez à nouveau %@ pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricollega il disco o il server mancante e sblocca l’elemento o la cartella bloccati, poi scegli di nuovo %@ per completare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見つからないディスクまたはサーバを接続し直し、ロックされている項目またはフォルダのロックを解除してから、もう一度“%@”を選択して完了してください。"
          }
        }
      }
    },
    "Reconnect the missing disk or server, then choose %@ again to finish." : {
      "comment" : "Suggested fix for undo or redo on a missing volume",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde das fehlende Volume oder den fehlenden Server erneut und wähle dann erneut „%@“, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectar el disco o servidor que falta y luego vuelve a elegir %@ para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez le disque ou le serveur manquant, puis choisissez à nouveau %@ pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricollega il disco o il server mancante, poi scegli di nuovo %@ per completare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
