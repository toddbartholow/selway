          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aperçu de l’élément sélectionné à côté de la liste ou des icônes. Présentation → Afficher l’aperçu (⇧⌘P)"
          }
        },
        "it" : {
          "stringUnit" : {
