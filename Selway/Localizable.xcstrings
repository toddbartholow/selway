          }
        }
      }
    },
    "The server wasn’t found. Check its name or address, and that this Mac is on its network." : {
      "comment" : "Server connection failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wurde nicht gefunden. Prüfe seinen Namen oder seine Adresse und ob dieser Mac mit seinem Netzwerk verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado el servidor. Comprueba su nombre o dirección, y que este Mac está en su red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur est introuvable. Vérifiez son nom ou son adresse, et que ce Mac est sur son réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server non trovato. Verifica il nome o l’indirizzo e che questo Mac sia sulla sua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
