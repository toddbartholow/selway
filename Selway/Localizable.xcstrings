    "A “%1$@” in the address must be followed by two hexadecimal digits. Type a percent sign as %2$@." : {
      "comment" : "Server address validation error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf ein „%1$@“ in der Adresse müssen zwei Hexadezimalziffern folgen. Gib ein Prozentzeichen als %2$@ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un “%1$@” en la dirección debe ir seguido de dos dígitos hexadecimales. Escribe un signo de porcentaje como %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’adresse, un « %1$@ » doit être suivi de deux chiffres hexadécimaux. Saisissez un signe pourcentage sous la forme %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un “%1$@” nell’indirizzo deve essere seguito da due cifre esadecimali. Digita il segno di percentuale come %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレス内の“%1$@”の後には2桁の16進数が必要です。パーセント記号は%2$@と入力してください。"
          }
        }
      }
    },
    "A button appears for each app Selway finds on this Mac. Claude Code opens in %@." : {
      "comment" : "Note under Settings → Integrations → Toolbar and menu buttons. %@ is the terminal app Claude Code runs in, such as Terminal or iTerm.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jede App, die Selway auf diesem Mac findet, wird eine Taste angezeigt. Claude Code wird in %@ geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece un botón por cada aplicación que Selway encuentra en este Mac. Claude Code se abre en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton apparaît pour chaque application que Selway trouve sur ce Mac. Claude Code s’ouvre dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni app che Selway trova su questo Mac compare un pulsante. Claude Code si apre in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelwayがこのMacで見つけたアプリケーションごとにボタンが表示されます。Claude Codeは“%@”で開きます。"
          }
        }
      }
    },
