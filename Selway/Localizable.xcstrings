    "What Command-Delete does to the selected items. ⌥⌘⌫ deletes permanently." : {
      "comment" : "Settings explanation of what Command-Delete does when permanent deletion is selected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Befehl-Rückschritttaste mit den ausgewählten Objekten macht. ⌥⌘⌫ löscht endgültig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hace Comando + Eliminar con los ítems seleccionados. ⌥⌘⌫ los elimina permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effet de la combinaison Commande + Supprimer sur les éléments sélectionnés. ⌥⌘⌫ supprime définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fa Comando-Elimina agli elementi selezionati. ⌥⌘⌫ elimina definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
