    "“%@”" : {
      "comment" : "One item's name in quotation marks, in a completed-operation toast (\"Copied “photo.jpg”\"). Use your language's quotation marks.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        }
      }
    },
    "“%@” can’t be copied into itself" : {
      "comment" : "File operation status with item name for copy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht in sich selbst kopiert werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se puede copiar dentro de sí mismo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de copier « %@ » dans lui-même"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può essere copiato in se stesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をそれ自体の中にコピーすることはできません"
          }
        }
      }
    },
    "“%@” can’t be copied or moved into itself." : {
      "comment" : "File operation error with item name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht in sich selbst kopiert oder bewegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se puede copiar ni trasladar dentro de sí mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de copier ou de déplacer « %@ » dans lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può essere copiato o spostato in se stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をそれ自体の中にコピーまたは移動することはできません。"
          }
        }
      }
    },
    "“%@” can’t be moved into itself" : {
