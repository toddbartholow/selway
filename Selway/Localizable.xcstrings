    "Servers on your network, listed when you open it" : {
      "comment" : "Settings description of the Network section in the Locations sidebar.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server in deinem Netzwerk, aufgeführt, sobald du es öffnest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores de tu red, que se muestran cuando la abres"
          }
