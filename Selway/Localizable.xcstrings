    "Delete Permanently removes items at once, without asking. They can’t be recovered." : {
      "comment" : "Settings warning shown when confirmation before permanent deletion is turned off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Endgültig löschen“ entfernt Objekte sofort und ohne Nachfrage. Sie können nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar permanentemente borra los ítems al instante, sin preguntar. No se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Supprimer définitivement » efface les éléments immédiatement, sans confirmation. Ils sont irrécupérables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente rimuove subito gli elementi, senza chiedere. Non possono essere recuperati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“完全に削除”を選択すると、確認なしで項目がすぐに削除されます。項目を復元することはできません。"
          }
        }
      }
    },
    "Delete Permanently will remove items at once. They won’t go to the Trash, and Undo can’t bring them back." : {
      "comment" : "Permanent delete warning",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Endgültig löschen“ entfernt Objekte sofort. Sie werden nicht in den Papierkorb gelegt und lassen sich nicht mit „Widerrufen“ zurückholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar permanentemente borrará los ítems al instante. No irán a la papelera y Deshacer no podrá recuperarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Supprimer définitivement » efface les éléments immédiatement. Ils ne seront pas placés dans la corbeille, et la commande Annuler ne pourra pas les restaurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente rimuoverà subito gli elementi. Non andranno nel Cestino e Annulla non potrà recuperarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“完全に削除”を選択すると、項目がすぐに削除されます。項目はゴミ箱に入らず、“取り消す”で元に戻すこともできません。"
          }
        }
      }
    },
