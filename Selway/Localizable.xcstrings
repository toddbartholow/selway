        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "It stopped %lld time in a minute, so Selway closed it instead of reopening your files. Open them again to keep editing."
                }
