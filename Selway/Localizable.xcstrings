    "FTP servers connect read-only: you can open and copy files, not change them." : {
      "comment" : "Hint explaining read-only FTP access",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP-Server werden schreibgeschützt verbunden: Du kannst Dateien öffnen und kopieren, aber nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores FTP se conectan en modo de solo lectura: puedes abrir y copiar archivos, pero no modificarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs FTP se connectent en lecture seule : vous pouvez ouvrir et copier des fichiers, mais pas les modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server FTP si connettono in sola lettura: puoi aprire e copiare i file, ma non modificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTPサーバには読み出し専用で接続します: ファイルを開いたりコピーしたりできますが、変更はできません。"
          }
        }
      }
    },
    "ftp:// sends your password and files unencrypted." : {
      "comment" : "Security hint for FTP server connections",
      "localizations" : {
